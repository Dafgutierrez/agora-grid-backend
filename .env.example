# Long random string that protects /dashboard and the mutating endpoints.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=replace-with-a-long-random-string

# From your Stripe dashboard (start with a *test* key: sk_test_...)
STRIPE_SECRET_KEY=

# From the webhook endpoint you register in Stripe, pointing at
# https://<your-deployed-host>/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Where Stripe Checkout redirects the buyer after payment.
CHECKOUT_SUCCESS_URL=https://example.com/success
CHECKOUT_CANCEL_URL=https://example.com/cancel

# SQLite file path.
DATABASE_PATH=./agora.db

# From console.anthropic.com — a separate account/billing from any chat
# subscription. Powers the real LLM-driven agent decisions in app/agents.py.
# Each POST /api/agents/tick makes one real, billed API call per agent.
ANTHROPIC_API_KEY=

# Optional: override the model used for agent decisions (defaults to a
# fast/cheap model, deliberately, since these are simple structured
# accept/decline/price calls made repeatedly, not deep reasoning).
AGENT_MODEL=claude-haiku-4-5-20251001
